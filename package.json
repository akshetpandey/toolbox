{
  "name": "toolbox",
  "private": false,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite dev --port 5050",
    "build": "vite build && node scripts/compress-wasm.mjs",
    "serve": "vite preview",
    "test": "vitest run && vitest run --config vitest.browser.config.ts",
    "test:unit": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "check": "pnpm lint:fix && pnpm format && pnpm typecheck",
    "preview": "wrangler dev --assets dist",
    "deploy": "pnpm build && wrangler deploy",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "7z-wasm": "^1.2.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ffmpeg/core-mt": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@imagemagick/magick-wasm": "^0.0.45",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "@myriaddreamin/typst.ts": "0.7.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/react": "^11.9.0",
    "@tanstack/react-router": "^1.170.46",
    "@uswriting/exiftool": "^1.0.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "emoji-picker-react": "^5.1.4",
    "fuse.js": "^7.5.0",
    "hash-wasm": "^4.12.0",
    "libimagequant-wasm": "^0.5.0",
    "lucide-react": "^1.61.0",
    "pandoc-wasm": "^1.1.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "wasmagic": "^1.0.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@sentry/vite-plugin": "^11.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.48",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "playwright": "^1.64.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "web-vitals": "^6.2.3",
    "wrangler": "^4.152.0"
  }
}
